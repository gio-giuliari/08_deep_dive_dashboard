guess_pcode_col <- function(nms) {
  preferred <- c("ADM2_PCODE","adm2_pcode","pcode","admin2_pcode")
  hit <- preferred[preferred %in% nms]
  if (length(hit)) return(hit[1])
  nlow <- tolower(nms)
  regex_hit <- grepl("pcode|^adm[0-9]_?pcode$|^adm[0-9]+_?pcode$|unit[\\s_\\.]*of[\\s_\\.]*analysis|^ua$|^code$|p_code", nlow)
  if (any(regex_hit)) return(nms[which(regex_hit)[1]])
  nms[1]
}

guess_name_col <- function(nms) {
  preferred <- c("ADM2_EN","adm2_en","ADM2_NAME","adm2_name","NAME_2","name_2","NAME_EN","name_en","NAME","name")
  hit <- preferred[preferred %in% nms]
  if (length(hit)) return(hit[1])
  NA_character_
}

guess_adm1_name_col <- function(nms) {
  preferred <- c("ADM1_EN","adm1_en","ADM1_NAME","adm1_name","NAME_1","name_1","STATE","state","PROVINCE","province","REGION","region")
  hit <- preferred[preferred %in% nms]
  if (length(hit)) return(hit[1])
  NA_character_
}

read_shapefile_with_restore <- function(shp_path) {
  shp <- try(sf::st_read(shp_path, quiet = TRUE, stringsAsFactors = FALSE), silent = TRUE)
  if (!inherits(shp, "try-error")) return(shp)
  Sys.setenv("SHAPE_RESTORE_SHX" = "YES", "CPL_SHAPE_RESTORE_SHX" = "YES")
  shp2 <- try(sf::st_read(shp_path, quiet = TRUE, stringsAsFactors = FALSE), silent = TRUE)
  Sys.unsetenv("SHAPE_RESTORE_SHX"); Sys.unsetenv("CPL_SHAPE_RESTORE_SHX")
  if (!inherits(shp2, "try-error")) return(shp2)
  stop("Cannot open shapefile — missing sidecar files or unsupported format.")
}

read_boundary_zip_only <- function(files) {
  req(files)
  stopifnot(length(files$datapath) >= 1)
  datapath <- files$datapath[1]
  ext <- tolower(tools::file_ext(files$name[1]))
  validate(need(ext == "zip", "Please upload a single .zip shapefile (with .shp/.shx/.dbf)."))
  td <- tempfile("shpzip_"); dir.create(td)
  utils::unzip(datapath, exdir = td)
  shp_candidates <- list.files(td, pattern = "\\.shp$", full.names = TRUE, ignore.case = TRUE, recursive = TRUE)
  validate(need(length(shp_candidates) > 0, "No .shp found inside the .zip."))
  pick <- NULL
  for (s in shp_candidates) {
    base <- sub("\\.[sS][hH][pP]$", "", s)
    has_shx <- file.exists(paste0(base, ".shx")) || file.exists(paste0(base, ".SHX"))
    has_dbf <- file.exists(paste0(base, ".dbf")) || file.exists(paste0(base, ".DBF"))
    if (has_shx && has_dbf) { pick <- s; break }
  }
  if (is.null(pick)) pick <- shp_candidates[1]
  read_shapefile_with_restore(pick)
}

