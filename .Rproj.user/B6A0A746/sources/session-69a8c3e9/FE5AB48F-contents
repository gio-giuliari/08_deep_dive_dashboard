server <- function(input, output, session) {
  plan(multisession)
 
  
  #=============================================================================#
  ########################### SV.1 - REACTIVES & HELPERS ########################
  #=============================================================================# 

  uploaded_raw       <- reactiveVal(NULL)
  processed_df       <- reactiveVal(NULL)   # list with $final_result, etc.
  is_processing_flag <- reactiveVal(FALSE)
  boundary_sf_main   <- reactiveVal(NULL)   # shared shapefile
  pending_bounds     <- reactiveVal(NULL)
  
  set_client_processing <- function(value) {
    is_processing_flag(value)
    session$sendCustomMessage(type = 'updateIsProcessing', message = list(isProcessing = value))
  }
  
  output$showResults <- reactive({ !is.null(processed_df()) && !is_processing_flag() })
  outputOptions(output, "showResults", suspendWhenHidden = FALSE)
  
  # SUMMARY CONSTANTS & HELPERS 
  summary_levels <- c(
    "Excess Mortality",
    "Risk of Excess Mortality",
    "Acute Needs",
    "Insufficient Data/Probe with Shocks and Vulnerability"
  )
  summary_colors <- c("#8B0000", "#E53935", "#FB8C00", "#9E9E9E")
  NO_DATA_COLOR  <- "#EEEEEE"
  
  normalize_summary <- function(x) {
    if (is.null(x)) return(rep(NA_character_, 0))
    z <- as.character(x)
    z <- trimws(tolower(gsub("[\u2018\u2019\u201C\u201D]", "'", z))) # normalize smart quotes
    dplyr::case_when(
      grepl("^excess\\s*mort", z) ~ "Excess Mortality",
      grepl("^risk\\s*of\\s*excess\\s*mort", z) ~ "Risk of Excess Mortality",
      grepl("^acute\\s*need", z) ~ "Acute Needs",
      grepl("insufficient\\s*data|probe|shock|vulnerab", z) ~
        "Insufficient Data/Probe with Shocks and Vulnerability",
      TRUE ~ NA_character_
    )
  }
  
  #  MAP HELPERS 
  base_leaflet <- function() {
    leaflet::leaflet(
      options = leaflet::leafletOptions(
        worldCopyJump      = TRUE,
        preferCanvas       = TRUE,
        zoomControl        = TRUE,
        attributionControl = FALSE,
        scrollWheelZoom    = TRUE
      )
    ) |>
      leaflet::addProviderTiles(leaflet::providers$CartoDB.Positron) |>
      leaflet::setView(lng = 20, lat = 5, zoom = 3) |>
      htmlwidgets::onRender("function(el,x){ this.zoomControl.setPosition('topright'); }")
  }
  
  paint_neutral_boundaries <- function(map_id, shp) {
    nm <- if ("adm2_name" %in% names(shp)) shp$adm2_name else if ("ADM2_EN" %in% names(shp)) shp$ADM2_EN else NA_character_
    popups <- paste0(
      "<strong>Name:</strong> ", htmltools::htmlEscape(ifelse(is.na(nm), "—", nm)), "<br/>",
      "<strong>Pcode:</strong> ", htmltools::htmlEscape(ifelse(!is.null(shp$ua_code), shp$ua_code, "—")), "<br/>",
      "<strong>Population Strata:</strong> —<br/>",
      "<strong>Summary:</strong> —"
    )
    leaflet::leafletProxy(map_id) |>
      leaflet::clearGroup("boundaries") |>
      leaflet::clearGroup("ana_fill") |>
      leaflet::clearControls() |>
      leaflet::addPolygons(
        data        = shp,
        group       = "boundaries",
        fillColor   = "#DDDDDD",
        fillOpacity = 0.6,
        color       = "#555555",
        weight      = 0.7,
        opacity     = 1,
        popup       = popups,
        highlightOptions = leaflet::highlightOptions(
          weight = 2, color = "#000000", fillOpacity = 0.8, bringToFront = TRUE
        )
      )
  }
  
  padded_bounds <- function(shp, pad = 0.05) {
    bb <- suppressWarnings(sf::st_bbox(shp))
    dx <- as.numeric(bb["xmax"] - bb["xmin"])
    dy <- as.numeric(bb["ymax"] - bb["ymin"])
    list(
      xmin = as.numeric(bb["xmin"]) - dx * pad,
      ymin = as.numeric(bb["ymin"]) - dy * pad,
      xmax = as.numeric(bb["xmax"]) + dx * pad,
      ymax = as.numeric(bb["ymax"]) + dy * pad
    )
  }
  
  #=============================================================================#
  ################################ SV.2 - DATA INPUT ############################
  #=============================================================================# 
  ana_input_data <- reactive({
    req(input$files)
    fp <- input$files$datapath
    df <- tryCatch(readxl::read_xlsx(fp), error = function(e) {
      showNotification(paste("Error reading uploaded file:", e$message), type = "error")
      NULL
    })
    uploaded_raw(df)
    df
  })
  
  observeEvent(input$files, {
    req(input$files)
    local_fp <- input$files$datapath
    set_client_processing(TRUE)
    
    future({
      library(dplyr); library(readxl); library(tidyr); library(openxlsx)
      source("1_flagging_function.R", local = TRUE)
      
      main_indicators <- tryCatch(
        openxlsx::read.xlsx("input/ANA_Base_File.xlsx", sheet = "REF Indicators_ANA"),
        error = function(e) NULL
      )
      main_flagging <- tryCatch(
        openxlsx::read.xlsx("input/ANA_Base_File.xlsx", sheet = "STEP 5 Flagging Chart"),
        error = function(e) NULL
      )
      flagging_names <- if (!is.null(main_flagging)) gsub("\\.", " ", names(main_flagging)) else NULL
      
      df <- readxl::read_xlsx(local_fp)
      ana_flagging(df)  
    }) %...>% (function(res_df) {
      processed_df(res_df)
      set_client_processing(FALSE)
      
      if ("adm2_pcode" %in% colnames(res_df$final_result)) {
        updateSelectInput(session, "filter_adm2",
                          choices = c("All" = "", unique(as.character(res_df$final_result$adm2_pcode)))
        )
      }
    }) %...!% (function(e) {
      set_client_processing(FALSE)
      processed_df(NULL)
      showNotification("Processing failed, the file is not in the required format. Please look at the information above.", type = "error")
    })
  })
 
  #=============================================================================#
  ################################ SV.3 - TABLE OUTPUTS #########################
  #=============================================================================# 
  
   
  output$processed_preview <- renderDT({
    res <- processed_df(); req(res, is.list(res), !is.null(res$final_result))
    df <- res$final_result
    
    if ("Unit of Analysis" %in% names(df)) {
      df[["Unit of Analysis"]] <- as.factor(df[["Unit of Analysis"]])
    }
    if (!is.null(input$filter_adm2) && nzchar(input$filter_adm2)) {
      df <- df %>% dplyr::filter(`Unit of Analysis` == input$filter_adm2)
    }
    
    DT::datatable(
      head(df, 200),
      rownames = FALSE,
      class    = "compact nowrap",
      filter   = "top",
      options  = list(
        pageLength    = 20,
        dom           = 'tp',
        scrollX       = TRUE,
        orderCellsTop = TRUE,
        autoWidth     = TRUE
      )
    )
  })
  
  summary_by_pg <- reactive({
    res <- processed_df(); req(res, is.list(res), !is.null(res$final_result))
    fr <- res$final_result
    req(all(c("Population Group", "SUMMARY PRELIMINARY FLAG CONCLUSION") %in% names(fr)))
    fr %>%
      dplyr::count(`Population Group`, `SUMMARY PRELIMINARY FLAG CONCLUSION`, name = "Count") %>%
      dplyr::group_by(`Population Group`) %>%
      dplyr::mutate(Percent = Count / sum(Count)) %>%
      dplyr::ungroup() %>%
      dplyr::arrange(`Population Group`, `SUMMARY PRELIMINARY FLAG CONCLUSION`)
  })
  
  output$summary_by_pg_table <- renderDT({
    df <- summary_by_pg(); req(df)
    DT::datatable(df, rownames = FALSE, class = "compact",
                  options = list(pageLength = 10, dom = 'tp', autoWidth = TRUE)) %>%
      DT::formatPercentage("Percent", digits = 1)
  })
  
  flag_summary_long <- reactive({
    res <- processed_df(); req(res, is.list(res), !is.null(res$final_result))
    fr <- res$final_result
    id_cols    <- intersect(c("Unit of Analysis", "Population Group"), names(fr))
    value_cols <- setdiff(names(fr), id_cols)
    long <- tidyr::pivot_longer(fr, cols = tidyselect::all_of(value_cols),
                                names_to = "Variable", values_to = "Value") %>%
      dplyr::filter(grepl("flag", Value, ignore.case = TRUE))
    vars_with_flag <- long %>% dplyr::filter(grepl("^flag$", Value, ignore.case = TRUE)) %>%
      dplyr::distinct(Variable)
    long <- long %>% dplyr::semi_join(vars_with_flag, by = "Variable")
    long %>%
      dplyr::count(`Population Group`, Variable, Value, name = "Count") %>%
      dplyr::group_by(`Population Group`, Variable) %>%
      dplyr::mutate(Percent = Count / sum(Count)) %>%
      dplyr::ungroup() %>%
      dplyr::arrange(`Population Group`, Variable, dplyr::desc(Count))
  })
  
  output$flag_summary_long_table <- renderDT({
    df <- flag_summary_long(); req(df)
    DT::datatable(df, rownames = FALSE, class = "compact nowrap",
                  options = list(pageLength = 10, dom = 'tp', autoWidth = TRUE)) %>%
      DT::formatPercentage("Percent", digits = 1)
  })
  
  #=============================================================================#
  ############################# SV.4 - DOWNLOAD HANDLER #########################
  #=============================================================================# 
  
  output$download <- downloadHandler(
    filename = function() {
      req(processed_df())
      country_label <- if (!is.null(input$country)) input$country else "no_country"
      paste0(Sys.Date(), "_", country_label, "_flagged_data.xlsx")
    },
    contentType = "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
    content = function(file) {
      res <- processed_df(); req(res, is.list(res))
      final_result        <- res$final_result;        req(final_result)
      input_wide          <- res$input_wide;          req(input_wide)
      input_long          <- res$input_long;          req(input_long)
      source_data_flagged <- res$source_data_flagged; req(source_data_flagged)
      
      summary_results      <- summary_by_pg()
      flag_summary_long_df <- flag_summary_long()
      
      wb <- openxlsx::createWorkbook()
      openxlsx::addWorksheet(wb, "Flagging File Final")
      openxlsx::addWorksheet(wb, "Flagging Sub-Factor")
      openxlsx::addWorksheet(wb, "Flagging Indicator Contribution")
      openxlsx::addWorksheet(wb, "Source Data Flagged")
      openxlsx::addWorksheet(wb, "Flagging Results Summary")
      openxlsx::addWorksheet(wb, "Flagging All Indicators Summary")
      
      openxlsx::writeData(wb, "Flagging File Final",             final_result)
      openxlsx::writeData(wb, "Flagging Sub-Factor",             input_wide)
      openxlsx::writeData(wb, "Flagging Indicator Contribution", input_long)
      openxlsx::writeData(wb, "Source Data Flagged",             source_data_flagged)
      openxlsx::writeData(wb, "Flagging Results Summary",        summary_results)
      openxlsx::writeData(wb, "Flagging All Indicators Summary", flag_summary_long_df)
      
      header_style <- openxlsx::createStyle(
        textDecoration = "bold", halign = "center", valign = "center",
        wrapText = TRUE, fgFill = "#e34444", fontColour = "#FFFFFF"
      )
      flag_style     <- openxlsx::createStyle(fontColour = "#B00020", bgFill = "#FFE3E3", textDecoration = "bold")
      no_flag_style  <- openxlsx::createStyle(fontColour = "#1B5E20", bgFill = "#DFF0D8", textDecoration = "bold")
      no_data_style  <- openxlsx::createStyle(fontColour = "#424242", bgFill = "#F1F1F1", textDecoration = "bold")
      em_style       <- openxlsx::createStyle(fontColour = "#FFFFFF", bgFill = "#C62828", textDecoration = "bold")
      risk_style     <- openxlsx::createStyle(fontColour = "#FFFFFF", bgFill = "#EF5350", textDecoration = "bold")
      acute_style    <- openxlsx::createStyle(fontColour = "#FFFFFF", bgFill = "#E67E22", textDecoration = "bold")
      insuff_style   <- openxlsx::createStyle(fontColour = "#424242", bgFill = "#F1F1F1", textDecoration = "bold")
      
      style_sheet <- function(sheet_name, n_cols, n_rows, width_ref = n_cols) {
        openxlsx::addStyle(wb, sheet = sheet_name, style = header_style, rows = 1, cols = 1:n_cols, gridExpand = TRUE)
        openxlsx::setRowHeights(wb, sheet = sheet_name, rows = 1, heights = 50)
        openxlsx::setColWidths(wb, sheet = sheet_name, cols = 1:width_ref, widths = 30)
        openxlsx::freezePane(wb, sheet = sheet_name, firstRow = TRUE)
      }
      add_cf_flagset <- function(sheet_name, n_cols, n_rows) {
        if (n_rows > 0 && n_cols > 0) {
          r <- 2:(n_rows + 1); c <- 1:n_cols
          openxlsx::conditionalFormatting(wb, sheet = sheet_name, cols = c, rows = r,
                                          rule = '="Flag"', style = flag_style, type = "expression")
          openxlsx::conditionalFormatting(wb, sheet = sheet_name, cols = c, rows = r,
                                          rule = '="No Flag"', style = no_flag_style, type = "expression")
          openxlsx::conditionalFormatting(wb, sheet = sheet_name, cols = c, rows = r,
                                          rule = '="No Data"', style = no_data_style, type = "expression")
          openxlsx::conditionalFormatting(wb, sheet = sheet_name, cols = c, rows = r,
                                          rule = '="No Threshold"', style = no_data_style, type = "expression")
          openxlsx::conditionalFormatting(wb, sheet = sheet_name, cols = c, rows = r,
                                          rule = '="Insufficient Data"', style = no_data_style, type = "expression")
        }
      }
      add_cf_summary_pg <- function(sheet_name, n_cols, n_rows) {
        if (n_rows > 0 && n_cols > 0) {
          r <- 2:(n_rows + 1); c <- 1:n_cols
          openxlsx::conditionalFormatting(wb, sheet = sheet_name, cols = c, rows = r,
                                          rule = '="Excess Mortality"', style = em_style, type = "expression")
          openxlsx::conditionalFormatting(wb, sheet = sheet_name, cols = c, rows = r,
                                          rule = '="Risk of Excess Mortality"', style = risk_style, type = "expression")
          openxlsx::conditionalFormatting(wb, sheet = sheet_name, cols = c, rows = r,
                                          rule = '="Acute Needs"', style = acute_style, type = "expression")
          openxlsx::conditionalFormatting(wb, sheet = sheet_name, cols = c, rows = r,
                                          rule = '="Insufficient Data/Probe with Shocks and Vulnerability"', style = insuff_style, type = "expression")
        }
      }
      
      style_sheet("Flagging File Final",             ncol(final_result),         nrow(final_result))
      add_cf_flagset("Flagging File Final",          ncol(final_result),         nrow(final_result))
      style_sheet("Flagging Sub-Factor",             ncol(input_wide),           nrow(input_wide))
      add_cf_flagset("Flagging Sub-Factor",          ncol(input_wide),           nrow(input_wide))
      style_sheet("Flagging Indicator Contribution", ncol(input_long),           nrow(input_long))
      add_cf_flagset("Flagging Indicator Contribution", ncol(input_long),        nrow(input_long))
      style_sheet("Source Data Flagged",             ncol(source_data_flagged),  nrow(source_data_flagged))
      add_cf_flagset("Source Data Flagged",          ncol(source_data_flagged),  nrow(source_data_flagged))
      style_sheet("Flagging Results Summary",        ncol(summary_results),      nrow(summary_results))
      add_cf_summary_pg("Flagging Results Summary",  ncol(summary_results),      nrow(summary_results))
      style_sheet("Flagging All Indicators Summary", ncol(flag_summary_long_df), nrow(flag_summary_long_df))
      add_cf_flagset("Flagging All Indicators Summary", ncol(flag_summary_long_df), nrow(flag_summary_long_df))
      
      openxlsx::saveWorkbook(wb, file, overwrite = TRUE)
    }
  )
  
  #=============================================================================#
  ############################# SV.5 - SHAPEFILE INPUT ##########################
  #=============================================================================# 
  observeEvent(input$boundary_zip, {
    shp <- tryCatch(read_boundary_zip_only(input$boundary_zip), error = function(e) {
      showNotification(paste("Boundary upload failed:", e$message), type = "error", duration = 10)
      NULL
    })
    if (is.null(shp)) return(NULL)
    
    if (is.na(sf::st_crs(shp))) sf::st_crs(shp) <- 4326 else shp <- sf::st_transform(shp, 4326)
    name_col <- guess_name_col(names(shp))
    shp$adm2_name <- if (!is.na(name_col)) as.character(shp[[name_col]]) else NA_character_
    code_col <- guess_pcode_col(names(shp))
    shp$ua_code <- toupper(trimws(as.character(shp[[code_col]])))
    adm1_col <- guess_adm1_name_col(names(shp))
    shp$ADM1_EN <- if (!is.na(adm1_col)) as.character(shp[[adm1_col]]) else "—"
    if (!"ADM2_EN" %in% names(shp)) shp$ADM2_EN <- if (!is.na(name_col)) as.character(shp[[name_col]]) else shp$ua_code
    shp <- sf::st_make_valid(shp)
    boundary_sf_main(shp)
    
    pb <- padded_bounds(shp)
    pending_bounds(pb)
    
    paint_neutral_boundaries("cluster_map", shp)
    leaflet::leafletProxy("cluster_map") %>% fitBounds(pb$xmin, pb$ymin, pb$xmax, pb$ymax)
  })
  
  #=============================================================================#
  ############################# SV.6 - MAPPING OUTPUT ###########################
  #=============================================================================# 
  
  output$cluster_map <- renderLeaflet({ base_leaflet() })
  
  output$cluster_pop_ui <- renderUI({
    res <- processed_df(); if (is.null(res)) return(NULL)
    fr <- res$final_result
    nms <- names(fr)
    pop_col <- if ("Population Status" %in% nms) "Population Status" else if ("Population Group" %in% nms) "Population Group" else NULL
    if (is.null(pop_col)) return(NULL)
    vals <- sort(unique(as.character(fr[[pop_col]])))
    vals <- vals[!is.na(vals)]
    if (!length(vals)) return(NULL)
    selectInput("cluster_pop_status", label = NULL, choices = vals, selected = vals[1])
  })
  
  ana_filtered <- reactive({
    res <- processed_df(); req(res)
    fr <- res$final_result
    nms <- names(fr)
    ua_col  <- if ("Unit of Analysis" %in% nms) "Unit of Analysis" else if ("adm2_pcode" %in% nms) "adm2_pcode" else NULL
    pop_col <- if ("Population Status" %in% nms) "Population Status" else if ("Population Group" %in% nms) "Population Group" else NULL
    sum_col <- if ("SUMMARY RESULTS" %in% nms) "SUMMARY RESULTS" else if ("SUMMARY PRELIMINARY FLAG CONCLUSION" %in% nms) "SUMMARY PRELIMINARY FLAG CONCLUSION" else NULL
    
    validate(
      need(!is.null(ua_col),  "final_result must contain 'Unit of Analysis' (or 'adm2_pcode')."),
      need(!is.null(sum_col), "final_result must contain 'SUMMARY RESULTS' (or its alternate).")
    )
    
    df <- fr |>
      dplyr::select(dplyr::all_of(c(ua_col, sum_col, pop_col))) |>
      dplyr::rename(ua = !!ua_col, summary_cat = !!sum_col) |>
      dplyr::mutate(
        ua_code     = toupper(trimws(as.character(.data$ua))),
        summary_cat = as.character(.data$summary_cat),
        pop_status  = if (!is.null(pop_col)) as.character(.data[[pop_col]]) else NA_character_
      )
    
    sel <- input$cluster_pop_status
    if (!isTruthy(sel)) {
      vals <- sort(unique(df$pop_status)); vals <- vals[!is.na(vals)]
      if (length(vals)) sel <- vals[1]
    }
    if (isTruthy(sel)) dplyr::filter(df, pop_status == sel) else df[0, , drop = FALSE]
  })
  

  cluster_sf <- reactive({
    req(boundary_sf_main(), ana_filtered())
    shp <- boundary_sf_main()
    df  <- ana_filtered() %>% dplyr::mutate(summary_norm = normalize_summary(summary_cat))
    dplyr::left_join(shp, df, by = "ua_code") %>%
      dplyr::mutate(SUMMARY = factor(summary_norm, levels = summary_levels, ordered = TRUE))
  })
  

  output$cluster_center_notice <- renderUI({
    shp_ready <- !is.null(boundary_sf_main())
    res_ready <- !is.null(processed_df())
    if (shp_ready && res_ready) return(NULL)
    msg <- if (!shp_ready && !res_ready) {
      "Upload your ANA Excel file and the boundary shapefile (.zip) to display results."
    } else if (shp_ready && !res_ready) {
      "Upload your ANA Excel file to display results."
    } else {
      "Upload the boundary shapefile (.zip) to display results."
    }
    div(class = "center-notice",
        tags$h4(tags$i(class = "fa fa-exclamation-triangle", style = "color:#f39c12;margin-right:8px;"), "Action needed"),
        div(class = "msg", msg)
    )
  })
  
  # Palette & grouping cache
  cluster_cache <- reactiveVal(NULL)
  observeEvent(cluster_sf(), {
    s <- cluster_sf()
    
    pal <- leaflet::colorFactor(
      palette  = summary_colors,
      domain   = factor(summary_levels, levels = summary_levels, ordered = TRUE),
      na.color = NO_DATA_COLOR
    )
    
    plain <- s %>% sf::st_set_geometry(NULL)
    adm1_list    <- plain %>% dplyr::distinct(ADM1_EN) %>% dplyr::arrange(ADM1_EN) %>% dplyr::pull(ADM1_EN)
    adm1_to_adm2 <- split(plain$ADM2_EN, plain$ADM1_EN)
    
    cluster_cache(list(pal = pal, adm1_list = adm1_list, adm1_to_adm2 = adm1_to_adm2))
  })
  
  # Sidebar groups for clustering
  output$cluster_adm1_groups <- renderUI({
    cache <- cluster_cache(); if (is.null(cache)) return(NULL)
    adm1_list <- cache$adm1_list; adm1_to_adm2 <- cache$adm1_to_adm2
    safe_id <- function(x) paste0("cluster_adm1_", gsub("[^A-Za-z0-9_]+", "_", x))
    tagList(lapply(adm1_list, function(a1) {
      inputId <- safe_id(a1)
      choices <- sort(unique(adm1_to_adm2[[a1]]))
      div(class = "adm1-group", id = inputId,
          div(class = "adm1-header", a1),           
          div(class = "adm2-list",                   
              checkboxGroupInput(
                inputId, label = NULL,
                choices = choices, selected = character(0),
                inline = FALSE
              )
          ),
          tags$hr(class = "thin-hr")
      )
    }))
  })
  # Neutral paint on boundary upload
  observeEvent(boundary_sf_main(), {
    shp <- boundary_sf_main(); if (is.null(shp)) return()
    if (!"adm2_name" %in% names(shp)) {
      name_col <- guess_name_col(names(shp))
      shp$adm2_name <- if (!is.na(name_col)) as.character(shp[[name_col]]) else shp$ua_code
    }
    paint_neutral_boundaries("cluster_map", shp)
    pb <- padded_bounds(shp)
    leaflet::leafletProxy("cluster_map") %>% fitBounds(pb$xmin, pb$ymin, pb$xmax, pb$ymax)
  })
  
  # Paint categorized polygons — ORDER worst on top; COLOR by normalized factor
  observeEvent(cluster_sf(), {
    s <- cluster_sf(); cache <- cluster_cache(); req(cache)
    pal <- cache$pal
    
    # ensure worst classes draw last (on top)
    ord_idx <- match(as.character(s$SUMMARY), summary_levels)
    s <- s[order(ord_idx, na.last = TRUE, decreasing = TRUE), , drop = FALSE]
    
    popup_html <- paste0(
      "<strong>Name:</strong> ", htmltools::htmlEscape(ifelse(is.na(s$ADM2_EN), "—", s$ADM2_EN)), "<br/>",
      "<strong>Pcode:</strong> ", htmltools::htmlEscape(s$ua_code), "<br/>",
      "<strong>ADM1:</strong> ", htmltools::htmlEscape(ifelse(is.na(s$ADM1_EN), "—", s$ADM1_EN)), "<br/>",
      "<strong>Population Strata:</strong> ", htmltools::htmlEscape(ifelse(is.na(s$pop_status), "—", s$pop_status)), "<br/>",
      "<strong>Summary:</strong> ", htmltools::htmlEscape(ifelse(is.na(s$SUMMARY), "No Data", as.character(s$SUMMARY)))
    )
    
    leaflet::leafletProxy("cluster_map") %>%
      leaflet::clearGroup("ana_fill") %>%
      leaflet::clearControls() %>%
      leaflet::addPolygons(
        data = s,
        layerId = ~ADM2_EN,
        group   = "ana_fill",
        fillColor = ~pal(SUMMARY),
        fillOpacity = 0.85,
        color = "#444444",
        weight = 0.6,
        opacity = 1,
        popup = popup_html
      ) %>%
      leaflet::addLegend(
        position = "bottomleft",
        colors = unname(summary_colors),
        labels = summary_levels,
        title = "SUMMARY RESULTS",
        opacity = 0.95
      )
    
    pb <- padded_bounds(s)
    leaflet::leafletProxy("cluster_map") %>% fitBounds(pb$xmin, pb$ymin, pb$xmax, pb$ymax)
  })
  
  #=============================================================================#
  ################## SV.6 - MAPPING SELECTING FEATURE ###########################
  #=============================================================================# 
  
  cluster_selected <- reactiveVal(character(0))
  safe_id_cluster <- function(x) paste0("cluster_adm1_", gsub("[^A-Za-z0-9_]+", "_", x))
  
  observe({
    cache <- cluster_cache(); if (is.null(cache)) return()
    adm1_list <- cache$adm1_list
    ids <- safe_id_cluster(adm1_list)
    all_checked <- unique(unlist(lapply(ids, function(id) input[[id]]), use.names = FALSE))
    prev <- cluster_selected()
    add  <- setdiff(all_checked, prev)
    rem  <- setdiff(prev, all_checked)
    if (length(add)+length(rem)==0) return()
    cluster_selected(all_checked)
    draw_cluster_overlays(add, rem)
  })
  
  observeEvent(input$cluster_clear_sel, {
    cache <- cluster_cache(); if (is.null(cache)) return()
    adm1_list <- cache$adm1_list
    for (a1 in adm1_list) {
      session$sendCustomMessage("clusterSetGroupValues", list(id = safe_id_cluster(a1), values = list()))
    }
    prev <- cluster_selected()
    if (length(prev)) draw_cluster_overlays(add = character(0), rem = prev)
    cluster_selected(character(0))
  })
  
  draw_cluster_overlays <- function(add, rem) {
    s <- cluster_sf(); if (is.null(s)) return()
    lp <- leaflet::leafletProxy("cluster_map")
    if (length(rem) > 0) {
      for (nm in rem) {
        leaflet::removeShape(lp, paste0("poly_", nm))
        leaflet::removeShape(lp, paste0("bnd_", nm))
      }
    }
    if (length(add) > 0) {
      sel_poly <- s %>% dplyr::filter(ADM2_EN %in% add)
      sel_bnd  <- sf::st_as_sf(sf::st_boundary(sel_poly))
      sel_bnd$ADM2_EN <- sel_poly$ADM2_EN
      if (nrow(sel_poly) > 0) {
        lp <- lp %>% leaflet::addPolygons(
          data = sel_poly, layerId = paste0("poly_", sel_poly$ADM2_EN),
          fill = FALSE, color = "#FFFFFF", weight = 2, opacity = 1,
          group = "selected_polys"
        )
      }
      if (nrow(sel_bnd) > 0) {
        lp %>% leaflet::addPolylines(
          data = sel_bnd, layerId = paste0("bnd_", sel_bnd$ADM2_EN),
          color = "#000000", weight = 2.5, opacity = 1, dashArray = "3,3",
          group = "selected_outline"
        )
      }
    }
  }
  
  observeEvent(input$cluster_map_shape_click, {
    click <- input$cluster_map_shape_click; req(click$id)
    cache <- cluster_cache(); s <- cluster_sf(); req(cache, s)
    nm <- click$id
    row  <- s %>% dplyr::filter(ADM2_EN == nm) %>% dplyr::slice(1)
    req(nrow(row) == 1)
    a1 <- row$ADM1_EN
    choices <- sort(unique(cache$adm1_to_adm2[[a1]]))
    cur_all <- cluster_selected(); cur <- intersect(choices, cur_all)
    if (nm %in% cur) cur <- setdiff(cur, nm) else cur <- c(cur, nm)
    session$sendCustomMessage("clusterSetGroupValues", list(id = safe_id_cluster(a1), values = as.list(cur)))
  })
  

  set_client_processing(FALSE)
}

shinyApp(ui = ui, server = server)

