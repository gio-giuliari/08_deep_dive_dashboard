    tags$script(HTML("
(function(){

  // -------- Clustering filter + checkbox sync --------
  function getGroups(){ return document.querySelectorAll('#cluster-groups .adm1-group'); }
  function getRows(group){ return group.querySelectorAll('.shiny-options-group .form-check, .shiny-options-group .checkbox'); }
  function rowText(row){
    var inp = row.querySelector('input[type=\"checkbox\"]');
    var txt = (inp && typeof inp.value === 'string') ? inp.value : '';
    if(!txt){
      var lbl = row.querySelector('.form-check-label, label');
      txt = (lbl ? lbl.textContent : '');
    }
    return (txt || '').replace(/\\s+/g,' ').trim().toLowerCase();
  }
  function annotateGroup(group){
    getRows(group).forEach(function(row){
      row.dataset.name = rowText(row);
      row.classList.add('adm2-row');
      row.style.display = '';
    });
    group.classList.remove('hidden');
  }
  function annotateAll(){ getGroups().forEach(annotateGroup); }
  function applyFilter(){
    var qEl = document.getElementById('cluster_filter_text');
    var q = (qEl ? qEl.value : '').trim().toLowerCase();
    getGroups().forEach(function(group){
      var any=false;
      getRows(group).forEach(function(row){
        var name = row.dataset.name || '';
        var show = (q==='') || (name.indexOf(q)!==-1);
        row.style.display = show ? '' : 'none';
        if(show) any = true;
      });
      group.classList.toggle('hidden', !any);
    });
  }
  function debounce(fn,wait){ var t; return function(){ clearTimeout(t); var a=arguments,c=this; t=setTimeout(function(){fn.apply(c,a);}, wait||80);} }
  var applyFilterDebounced = debounce(applyFilter, 80);

  var sidebar=null, mo=null;
  function ensureObserver(){
    if(!sidebar){ sidebar = document.getElementById('cluster-groups'); }
    if(sidebar && !mo){
      mo = new MutationObserver(function(){
        var st = sidebar.scrollTop;
        annotateAll(); applyFilterDebounced();
        sidebar.scrollTop = st;
      });
      mo.observe(sidebar, {childList:true, subtree:true});
    }
  }



  // -------- Shiny custom message handlers --------
  Shiny.addCustomMessageHandler('clusterSetGroupValues', function(msg){
    var group = document.getElementById(msg.id);
    if(!group) return;
    var set = new Set(msg.values || []);
    var boxes = group.querySelectorAll('.shiny-options-group input[type=\"checkbox\"]');
    boxes.forEach(function(inp){
      var should = set.has(inp.value || '');
      if (inp.checked !== should) inp.checked = should;
    });
    Shiny.setInputValue(msg.id, Array.from(set), {priority:'event'});
  });

  Shiny.addCustomMessageHandler('openMail', function(message){
    window.location.href = message;
  });

  Shiny.addCustomMessageHandler('updateIsProcessing', function(message){
    Shiny.setInputValue('isProcessing', message.isProcessing, {priority: 'event'});
  });

  Shiny.addCustomMessageHandler('noScroll', function(message){
    window.scrollTo(0, window.pageYOffset);
  });



  // -------- DOM ready --------
  document.addEventListener('DOMContentLoaded', function(){
    // Initialize clustering sidebar observers
    ensureObserver();
    setTimeout(function(){ annotateAll(); applyFilterDebounced(); }, 300);

    // IntersectionObserver for .param-box fade-in/out on intro page
    try {
      var observerOptions = { root: null, rootMargin: '0px', threshold: 0.1 };
      var io = new IntersectionObserver(function(entries){
        entries.forEach(function(entry){
          var descriptions = entry.target.querySelectorAll('.description');
          if (entry.isIntersecting) {
            descriptions.forEach(function(description, index) {
              description.style.animation = 'fadeIn 2s forwards';
              description.style.animationDelay = (index * 0.5) + 's';
              description.style.opacity = 1;
            });
          } else {
            descriptions.forEach(function(description, index) {
              description.style.animation = 'fadeOut 2s forwards';
              description.style.animationDelay = (index * 0.5) + 's';
              description.style.opacity = 0;
            });
          }
        });
      }, observerOptions);
      document.querySelectorAll('.param-box').forEach(function(box){ io.observe(box); });
    } catch(e) { /* graceful if IntersectionObserver unsupported */ }
  });



  // -------- Delegated events --------
  document.addEventListener('input', function(e){
    if(e.target && e.target.id==='cluster_filter_text'){ applyFilterDebounced(); }
  });

  document.addEventListener('click', function(e){
    // Clear locality filter bubble
    if(e.target && e.target.id==='cluster_filter_clear'){
      var el = document.getElementById('cluster_filter_text');
      if(el){ el.value=''; applyFilterDebounced(); }
    }
  });

  // jQuery-enhanced interactions if jQuery is present
  if (typeof $ !== 'undefined') {
    // Toggle open card state on param-box click (outside .content)
    $(document).on('click', '.param-box', function(event){
      if(!$(event.target).closest('.content').length) { $(this).toggleClass('open'); }
    });
    // Contact link/email triggers
    $(document).on('click', '#contact-us-link, .email', function() {
      Shiny.setInputValue('open_email', Math.random());
    });
  } else {
    // Vanilla fallback for contact link/email
    document.addEventListener('click', function(e){
      if (e.target && (e.target.id === 'contact-us-link' || e.target.classList.contains('email'))) {
        Shiny.setInputValue('open_email', Math.random());
      }
    });
  }

  // Prevent entering fullscreen on Leaflet (keep layout stable)
  document.addEventListener('fullscreenchange', function() {
    if (document.fullscreenElement) { document.exitFullscreen().catch(function(){}); }
  });
})();
