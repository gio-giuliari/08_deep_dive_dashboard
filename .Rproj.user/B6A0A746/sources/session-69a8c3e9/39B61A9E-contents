server <- function(input, output, session) {
  
  # Preprocess MPI data
  all_combinations <- expand_grid(
    shapeName = unique(admin2$shapeName),
    Indicator = unique(mpi_data$Indicator),
    Year = unique(mpi_data$Year)
  )
  
  mpi_data <- all_combinations %>%
    left_join(mpi_data, by = c("shapeName", "Indicator", "Year")) %>%
    mutate(Score = ifelse(is.na(Score), NA, Score))
  
  # Precompute consistent color palettes for each indicator across all years
  color_palettes <- lapply(unique(mpi_data$Indicator), function(indicator) {
    data <- mpi_data %>%
      filter(Indicator == indicator) %>%
      pull(Score)
    valid_range <- range(data, na.rm = TRUE)
    if (is.infinite(valid_range[1]) || is.infinite(valid_range[2])) {
      valid_range <- c(0, 100)  # Fallback domain
    }
    list(palette = colorNumeric(rev(viridisLite::viridis(256)), domain = valid_range, na.color = "grey"),
         range = valid_range)
  })
  names(color_palettes) <- unique(mpi_data$Indicator)
  
  # Reactive filtered data
  reactive_mpi_data <- reactive({
    mpi_data %>%
      filter(Indicator == input$indicator, Year == input$year)
  })
  
  # Reactive map data
  reactive_map_data <- reactive({
    admin2 %>%
      left_join(reactive_mpi_data(), by = "shapeName")
  })
  
  # Render Leaflet map
  output$mymap <- renderLeaflet({
    map_data <- reactive_map_data()
    palette_info <- color_palettes[[input$indicator]]
    score_palette <- palette_info$palette  # Consistent color palette
    
    if (all(is.na(map_data$Score)) || nrow(map_data) == 0) {
      leaflet(map_data) %>%
        addProviderTiles(providers$CartoDB.Positron) %>%
        addPolygons(
          fillColor = "grey",
          fillOpacity = 1,
          color = "black",
          weight = 1,
          popup = ~paste(
            "<strong>Region:</strong>", shapeName, "<br>",
            "<strong>Deprivation Score:</strong> No data"
          )
        ) %>%
        addLegend(
          position = "bottomright",
          colors = "grey",
          labels = "No data",
          title = input$indicator
        )
    } else {
      leaflet(map_data) %>%
        setView(lng = 66, lat = 33, zoom = 6) %>% 
        addProviderTiles(providers$CartoDB.Positron) %>%
        addPolygons(
          fillColor = ~ifelse(is.na(Score), "grey", score_palette(Score)),
          fillOpacity = 1,
          color = "black",
          weight = 1,
          popup = ~paste(
            "<strong>Region:</strong>", shapeName, "<br>",
            "<strong>Deprivation Score:</strong>", ifelse(is.na(Score), "No data", paste0(round(Score, 2), "%"))
          )
        ) %>%
        addLegend(
          position = "bottomright",
          pal = score_palette,
          values = palette_info$range,
          title = input$indicator,
          na.label = "No data"
        )
    }
  })
  
  
  # Render side table
  output$side_table <- DT::renderDataTable({
    reactive_mpi_data() %>%
      arrange(desc(Score)) %>%
      select(shapeName, Score) %>%
      rename(Province=shapeName)%>%
      datatable(
        rownames = FALSE, 
        options = list(
          pageLength = 6, 
          lengthChange = FALSE,
          dom = "t",  # Only display the table
          initComplete = JS(
            "function(settings, json){",
            "  var table = settings.oInstance.api();",
            "  var pageinfo = table.page.info();",
            "  $('#of').text('of ' + pageinfo.pages);",
            "}"
          )
        ),
        callback = JS(
          "$('#first').on('click', function(){", 
          "  table.page('first').draw('page');",
          "  $('#page').val(1);",
          "});",
          "$('#previous').on('click', function(){", 
          "  table.page('previous').draw('page');",
          "  $('#page').val(table.page.info().page + 1);",
          "});",
          "$('#next').on('click', function(){", 
          "  table.page('next').draw('page');",
          "  $('#page').val(table.page.info().page + 1);",
          "});",
          "$('#last').on('click', function(){", 
          "  table.page('last').draw('page');",
          "  $('#page').val(table.page.info().pages);",
          "});",
          "$('#page').on('change', function(){",
          "  var page = parseInt($('#page').val());",
          "  if(!isNaN(page)){ table.page(page-1).draw('page'); }",
          "});"
        )
      )
  })
}

 




