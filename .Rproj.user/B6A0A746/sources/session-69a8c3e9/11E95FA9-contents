fix_geom_m <- function(x, tol = 1){
  x <- st_make_valid(x)
  x <- st_set_precision(x, tol) |> st_snap_to_grid(tol)
  x <- suppressWarnings(st_buffer(x, 0))
  st_collection_extract(x, "POLYGON")
}

adm2_fix_m <- fix_geom_m(adm2_geom_m, tol = 1) %>%
  group_by(.data[[id_col]]) %>%
  summarise(geometry = st_union(geometry), .groups = "drop")

