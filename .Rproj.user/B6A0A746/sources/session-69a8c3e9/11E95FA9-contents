perc_cols <- names(dplyr::select(df, dplyr::starts_with("%"), dplyr::starts_with("#")))
acl_cols  <- names(dplyr::select(df, dplyr::starts_with("acl_")))
cat_cols  <- intersect("dominant_livzone", names(df))

###################################################
########### 3.3 SPATIAL INPUTATION ################
###################################################

impute_num_spatial <- function(v){
  out <- v
  for(i in seq_along(v)){
    if(is.na(v[i])){
      nb_idx <- nb[[i]]
      if(length(nb_idx)){
        w  <- lw[[i]]
        nv <- v[nb_idx]
        ww <- w[!is.na(nv)]
        nv <- nv[!is.na(nv)]
        out[i] <- if(length(nv)) sum(nv*ww)/sum(ww) else stats::median(v, na.rm = TRUE)
      } else {
        out[i] <- stats::median(v, na.rm = TRUE)
      }
    }
  }
  out
}

dat_imp <- adm2_full_m
if (length(perc_cols)) {
  for (cn in perc_cols) dat_imp[[cn]] <- impute_num_spatial(dat_imp[[cn]])
}

# build numeric features matrix (scale); ONLY % and acl
to_numeric <- function(x){
  if (is.numeric(x)) return(x)
  if (is.integer(x) || is.logical(x)) return(as.numeric(x))
  if (is.factor(x)  || is.character(x)) return(suppressWarnings(as.numeric(x)))
  x
}

num_keep <- c(perc_cols, acl_cols)
num_df <- dat_imp %>%
  st_drop_geometry() %>%
  select(all_of(num_keep)) %>%
  mutate(across(everything(), to_numeric))

# drop zero-variance and all-NA
nzv <- vapply(num_df, function(x) sum(!is.na(x)) > 1 && stats::var(x, na.rm = TRUE) > 0, logical(1))
num_df <- num_df[, nzv, drop = FALSE]

# scale (assumes acl_ columns are already complete; only % were imputed)
X_num <- if (ncol(num_df)) scale(as.matrix(num_df)) else NULL

# categorical (no imputation)
X_cat <- if (length(cat_cols)) {
  cat_df <- dat_imp %>% st_drop_geometry() %>% select(all_of(cat_cols)) %>% mutate(across(everything(), ~ as.factor(.)))
  model.matrix(~ . - 1, data = cat_df)
} else NULL

# combine features
X <- if (!is.null(X_num) && !is.null(X_cat)) cbind(X_num, X_cat) else (X_num %||% X_cat)
if (is.null(X)) stop("No usable features: check that columns starting with '%' and/or 'acl_' exist.")

