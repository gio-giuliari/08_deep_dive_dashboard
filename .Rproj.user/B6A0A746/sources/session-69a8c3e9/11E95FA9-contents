nb <- st_contiguity(adm2_full_m)
lw <- st_weights(nb, style = "W")

ctr <- st_centroid(adm2_full_m)
geo_dist01 <- {
  d <- as.matrix(st_distance(ctr))
  (d - min(d)) / (max(d) - min(d))
}
D1 <- as.dist(geo_dist01)

# feature selection 
