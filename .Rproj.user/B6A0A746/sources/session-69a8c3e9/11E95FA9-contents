# Clean geometries (validity / tiny slivers)
clean <- function(x, tol = 1) {
  x <- st_make_valid(x)
  x <- st_set_precision(x, tol) |> st_snap_to_grid(tol)
  x <- st_make_valid(x)
  x <- suppressWarnings(st_buffer(x, 0))
  x <- st_collection_extract(x, "POLYGON")
  x
}

adm2_clean <- clean(adm2_proj)
lz_clean   <- clean(lz_proj)

# Intersection
