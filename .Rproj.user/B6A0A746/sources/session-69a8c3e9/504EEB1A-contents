process_deep_dive <- function(path) {
  message("Processing: ", path)
  
  raw <- read_excel(path, sheet = "Summary Sheet  ", col_names = FALSE)
  
  ## ---- 1) ADMIN TABLE -------------------------------------------------------
  admin_header_row  <- which(raw[[1]] == "Unit of analysis" &
                               raw[[2]] == "Administrative Level Label")
  systems_block_row <- which(raw[[1]] %in% c("Systems and outcomes ",
                                             "Systems and outcomes"))
  
  if (length(admin_header_row) == 0 || length(systems_block_row) == 0) {
    warning("Skipping (admin or systems block not found): ", path)
    return(NULL)
  }
  
  admin_header_row  <- admin_header_row[1]
  systems_block_row <- systems_block_row[1]
  
  admin_raw <- raw[(admin_header_row + 1):(systems_block_row - 1), 1:4]
  colnames(admin_raw) <- c("Unit of analysis",
                           "Administrative Level Label",
                           "Administrative Level P-Code",
                           "State")
  
  admin_df <- admin_raw %>%
    filter(!`Unit of analysis` %in% c("Date of ACH", "Date of ACH "),
           !is.na(`Administrative Level Label`)) %>%
    select(-`Unit of analysis`)
  
  ## ---- 2) SYSTEMS TABLE -----------------------------------------------------
  systems_header_row <- which(
    apply(raw, 1, function(r) any(r == "Chosen Most Likely Hypothesis", na.rm = TRUE))
  )
  
  if (length(systems_header_row) == 0) {
    warning("Skipping (systems header not found): ", path)
    return(NULL)
  }
  
  systems_header_row <- systems_header_row[1]
  
  header_row <- as.character(raw[systems_header_row, ])
  systems_value_cols <- which(!is.na(header_row) & seq_along(header_row) >= 5)
  systems_col_names  <- header_row[systems_value_cols]
  
  systems_raw <- raw[(systems_header_row + 1):nrow(raw), ]
  
  system_names <- apply(as.data.frame(systems_raw[, 1:4]), 1, function(z) {
    z <- z[!is.na(z)]
    if (length(z) == 0) NA_character_ else as.character(z[1])
  })
  
  systems_vals <- systems_raw[, systems_value_cols, drop = FALSE]
  
  systems_df <- tibble(
    System = str_squish(system_names)
  ) %>%
    bind_cols(as_tibble(systems_vals, .name_repair = "minimal")) %>%
    tidyr::fill(System, .direction = "down")
  
  colnames(systems_df)[-1] <- systems_col_names
  
  if (!"Flagged Factors" %in% names(systems_df)) {
    systems_df[["Flagged Factors"]] <- NA_character_
  }
  
  systems_df <- systems_df %>%
    filter(
      !is.na(System),
      System != "",
      # DO NOT DROP RoEM ANYMORE
      !System %in% c("Systems and outcomes", "Cross-systemic interaction")
    ) %>%
    group_by(System) %>%
    summarise(
      across(
        setdiff(names(.), c("System", "Flagged Factors")),
        ~ dplyr::first(na.omit(.x)),
        .names = "{.col}"
      ),
      `Flagged Factors` = paste(na.omit(`Flagged Factors`), collapse = "; "),
      .groups = "drop"
    )
  
  ## ---- 3) LONG FORMAT + ADMIN INFO -----------------------------------------
  systems_long <- systems_df %>%
    pivot_longer(
      cols      = -System,
      names_to  = "indicator",
      values_to = "value"
    ) %>%
    filter(!is.na(value), value != "")
  
  final_long <- tidyr::crossing(admin_df, systems_long) %>%
    mutate(source_file = basename(path))
  
  final_long
}

