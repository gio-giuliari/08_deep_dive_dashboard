order_system_cols <- function(pattern, cols, ind_priority) {
  sys_cols <- grep(pattern, cols, value = TRUE, ignore.case = TRUE)
  if (length(sys_cols) == 0) return(character(0))
  indicators <- sub(".* - ", "", sys_cols)
  base_rank  <- match(indicators, ind_priority)
  base_rank[is.na(base_rank)] <- length(ind_priority) + seq_len(sum(is.na(base_rank)))
  sys_cols[order(base_rank)]
}

food_cols   <- order_system_cols("^Food",   other_cols, ind_priority)
water_cols  <- order_system_cols("^Water",  other_cols, ind_priority)
living_cols <- order_system_cols("^Living", other_cols, ind_priority)
health_cols <- order_system_cols("^Health", other_cols, ind_priority)

