  mutate(
    ADM2_EN = case_when(
      ADM2_EN == "Ar Rahad" & ADM1_EN == "Gedaref" ~ "Ar Rahad - Gf",
      ADM2_EN == "Ar Rahad" & ADM1_EN == "North Kordofan" ~ "Ar Rahad - NK",
