# app.R — no-flicker UI updates: instant checkbox sync via JS, robust filter, bold borders

library(shiny)
library(shinythemes)
library(shinyjs)
library(sf)
library(readxl)
library(dplyr)
library(tidyr)
library(stringr)
library(leaflet)
library(htmltools)

# ----------------------------- DATA ------------------------------------------
adm2_raw <- st_read("input/Admin2/SDN_Admin2.shp", quiet = TRUE)

adm2_3857 <- adm2_raw |>
  st_make_valid() |>
  st_transform(3857)
adm2_3857_s <- st_simplify(adm2_3857, dTolerance = 150, preserveTopology = TRUE)
adm2 <- st_transform(adm2_3857_s, 4326)

adm2_boundaries <- st_as_sf(st_boundary(adm2))
adm2_boundaries$ADM2_PCODE <- adm2$ADM2_PCODE
adm2_boundaries$ADM2_EN    <- adm2$ADM2_EN
adm2_boundaries$ADM1_EN    <- adm2$ADM1_EN

ana_data <- read_xlsx("input/03_ANA_Flagging_Analysis.xlsx")

normalize_value <- function(x) {
  y <- x |>
    str_replace_all("\u00A0", " ") |>
    str_replace_all("[–—-]", "-") |>
    str_squish() |>
    str_to_lower()
  dplyr::case_when(
    str_detect(y, "risk")  & str_detect(y, "excess") & str_detect(y, "mort") ~ "Risk of Excess Mortality",
    str_detect(y, "excess") & str_detect(y, "mort")                           ~ "Excess Mortality",
    str_detect(y, "insuff") | str_detect(y, "probe")                          ~ "Insufficient Data/Probe with Shocks and Vulnerability",
    str_detect(y, "acute")                                                     ~ "Acute Needs",
    TRUE                                                                       ~ NA_character_
  )
}

levels_vec <- c(
  "Excess Mortality",
  "Risk of Excess Mortality",
  "Acute Needs",
  "Insufficient Data/Probe with Shocks and Vulnerability"
)

summary_colors <- setNames(c("#F2B53C", "#D94A50", "#AEB4B8", "#EA724A"), levels_vec)

ana_summary <- ana_data %>%
  select(`Unit of Analysis`,
         `Unit of Analysis Label`,
         `SUMMARY PRELIMINARY FLAG CONCLUSION`) %>%
  rename(
    ADM2_PCODE_join = `Unit of Analysis`,
    ADM2_LABEL      = `Unit of Analysis Label`,
    SUMMARY_RAW     = `SUMMARY PRELIMINARY FLAG CONCLUSION`
  ) %>%
  mutate(
    SUMMARY = normalize_value(SUMMARY_RAW),
    SUMMARY = factor(SUMMARY, levels = levels_vec, ordered = TRUE)
  )

summary_data <- adm2 %>%
  left_join(ana_summary, by = join_by(ADM2_PCODE == ADM2_PCODE_join))

if (!"ADM2_EN" %in% names(summary_data)) {
  summary_data$ADM2_EN <- adm2$ADM2_EN[match(summary_data$ADM2_PCODE, adm2$ADM2_PCODE)]
}
if (!"ADM1_EN" %in% names(summary_data)) {
  summary_data$ADM1_EN <- adm2$ADM1_EN[match(summary_data$ADM2_PCODE, adm2$ADM2_PCODE)]
}

summary_data <- summary_data %>% arrange(SUMMARY, ADM1_EN, ADM2_EN)

pal <- colorFactor(palette = unname(summary_colors), domain = levels_vec, na.color = "#bdbdbd")

adm1_list <- summary_data |> st_set_geometry(NULL) |> distinct(ADM1_EN) |> arrange(ADM1_EN) |> pull(ADM1_EN)
adm1_to_adm2 <- split(summary_data$ADM2_EN, summary_data$ADM1_EN)
safe_id <- function(x) paste0("adm1_", gsub("[^A-Za-z0-9_]+", "_", x))

# Map each ADM2 to its ADM1 (for targeted updates)
adm2_to_adm1_tbl <- summary_data |>
  st_set_geometry(NULL) |>
  select(ADM2_EN, ADM1_EN) |>
  distinct()
adm2_to_adm1 <- setNames(adm2_to_adm1_tbl$ADM1_EN, adm2_to_adm1_tbl$ADM2_EN)

# ================================ UI ==========================================
ui <- bootstrapPage(
  useShinyjs(),
  tags$head(
    tags$style(HTML("
    body { margin-top: 50px !important; }
    .content-wrapper { margin-top: 50px !important; }

    .fixed-container {
      position: sticky; top: 0; z-index: 9999; background-color: white;
