##################################################
### 01- Step 2 consolidation of indicator data ###
##################################################


### PROCESS ###

# Take all compiled resources from the ANA_Indicator_Compilation_SDN file, pivot
# them to long format by id and add the column names as indicators and consolidate
# them in a single file following the format of the tab "STEP 3 Values"
# in the "ANA_Flagging_Indicator_to_fill_SDN". Then full join
# "REF_indicator_ANA" by indicator name. 


### INPUTS ### 

# 1. ANA_Indicator_Compilation_Sudan - list of all data points collected by admin2
# 2. ANA_Flagging_Indicator_to_fill_SDN - excel flagging file that needs filling

### OUTPUTS ###

# 1. for each admin 2 row in the sheet Flagging_Indicator_to_fill collect all 
#    indicators that need to be included in the analysis



remove(list = ls())

# Load all necessary libraries via pacman
if (!require("pacman")) install.packages("pacman")
library(pacman)
p_load(
  tidyverse, dplyr, here, lubridate, janitor, httr, jsonlite, 
  openxlsx, readxl, skimr, fuzzyjoin, zoo, pastecs, miceadds, ripc
)


# inputs
ana_data_long<- "03_output/01_ANA_consolidated_data/01_ANA_full_data_long.xlsx"
ana_data_wide<- "03_output/01_ANA_consolidated_data/02_ANA_full_data_wide.xlsx"
flagging_chart<- "01_input/ANA_Base_File.xlsx"
pcode_file       <- "01_input/02_Geographic_Datasets/sudan_pcodes.xlsx"


source("05_utils/utils.R")

################################################################################
########################## STEP 0 - LOAD DATA  #################################
################################################################################

flagging_names <- as.character(unlist(
  read.xlsx(flagging_chart,
            sheet = "STEP 5 Flagging Chart",
            rows = 1,        
            colNames = FALSE 
  )[1, ])
)

flagging_names <- flagging_names[!grepl("_qualitative$", flagging_names)]

df_merged <- read_xlsx(ana_data_long) %>%
  rename(acute_needs_threshold = `Acute.needs.threshold.(4)`,
         very_acute_needs_threshold = `Very.acute.needs.threshold.(5)`,
         evidence_threshold= Evidence.threshold,
         factor_threshold= Factor.threshold,
         indicator_id=Indicator.ID,
         sub_factor= `Sub-factor`,
         above_or_below= Above.or.below,
         risk_concept= Risk.concept)%>%
  select(-c("MSNA.module", "MSNA.indicator","Question.KOBO.Code",
            "Remarks/Limitations", "Indicator.choice")) %>%
  rename_with(tolower) 

# Remove duplicates just in case
df_merged <- df_merged[!duplicated(df_merged), ]

pcodes<- read.xlsx(pcode_file)

################################################################################
########################## STEP 3 - FLAGGING SYSTEM PREP #######################
################################################################################


# This is where you choose whether to use global thresholds (from indicator bank) or dynamic percentile based 
df_metrics <- df_merged %>%
  mutate(
    acute_needs_threshold= ifelse(is.na(acute_needs_threshold)& !is.na(very_acute_needs_threshold), 
                                  very_acute_needs_threshold,acute_needs_threshold ),
    metric_flag = case_when(
      is.na(value) | is.na(acute_needs_threshold) ~ NA_real_, # missing data
      above_or_below == "Above" & as.numeric(value) >= as.numeric(acute_needs_threshold) ~ 1, # flagged if above threshold
      above_or_below == "Below" & as.numeric(value) <= as.numeric(acute_needs_threshold) ~ 1, # flagged if below threshold
      TRUE ~ 0 # otherwise no flag
    ),
    metric_flag_very_acute=case_when(
      is.na(value) | is.na(very_acute_needs_threshold)  ~ NA_real_, # missing data
      above_or_below == "Above" & as.numeric(value) >= as.numeric(very_acute_needs_threshold) ~ 1, # flagged if above threshold
      above_or_below == "Below" & as.numeric(value) <= as.numeric(very_acute_needs_threshold) ~ 1, # flagged if below threshold
      TRUE ~ 0 # otherwise no flag
    )
  )

input_long <- df_metrics %>%
  group_by(adm2_pcode, level,system, factor) %>%
  summarise(
    metrics_with_data = sum(!is.na(metric_flag)), # metrics with valid data
    metrics_flagged   = sum(metric_flag == 1, na.rm = TRUE), # metrics flagged
    evidence_threshold = first(evidence_threshold),
    factor_threshold   = first(factor_threshold),
    .groups = "drop"
  ) %>%
  mutate(
    evidence_output = ifelse(metrics_with_data >= evidence_threshold, 1, NA),
    factor_output = case_when(
      evidence_output == 1 & metrics_flagged >= factor_threshold ~ "Flag",
      evidence_output == 1 & metrics_flagged < factor_threshold  ~ "No Flag",
      TRUE ~ "No Data"
    )
  ) %>%
  rename("Unit of Analysis" = adm2_pcode) %>% 
  left_join(
    pcodes %>%
      select(ADM2_PCODE, ADM2_EN) %>%
      rename("Unit of Analysis Label" = ADM2_EN,
             "Unit of Analysis"= ADM2_PCODE)
  ) %>%
  relocate("Unit of Analysis Label", .after = "Unit of Analysis")


input_wide <- input_long %>%
  select(`Unit of Analysis`,`Unit of Analysis Label`, factor, factor_output) %>%
  distinct() %>%
  pivot_wider(
    id_cols    = c("Unit of Analysis", "Unit of Analysis Label"),
    names_from = factor,
    values_from= factor_output,
    values_fn  = dplyr::first,
    values_fill = "No Data"
  ) %>%
  relocate("Unit of Analysis Label", .after = "Unit of Analysis")


################################################################################
########################## STEP 3 - RUN FLAGGING SYSTEM  #######################
################################################################################

custom_order <- c(
  "Excess Mortality",
  "Risk of Excess Mortality",
  "Acute Needs",
  "Insufficient Data/Probe with Shocks and Vulnerability"
)

final_result <- input_wide %>%
  mutate(
    `Health and nutrition services system` = `Health/Nutrition services`,
    `Health and nutrition services` = `Health/Nutrition services`,
    `Sanitation and hygiene systems` = `Sanitaiton & Hygiene`,
    `Market systems` = `Market functionality`,
    `Water systems` = `Water systems (infrastructure)`,
    `Water Consumption` = `HH Water consumption`,
    `HH water security` = `HH Water security`,
    `Nutrition Status` = `Nutrition status`,
    `Living conditions system` = pmap_chr(
      list(`Sanitaiton & Hygiene`, `Living conditions`),
      combine_status
    ),
    `Water system` = pmap_chr(
      list(`HH Water consumption`,
           `HH Water security`,
           `Water systems (infrastructure)`),
      combine_status
    ),
    `Food system` = pmap_chr(
      list(`Food consumption`, `HH Food security`),
      combine_status
    ),
    `Health outcome` = pmap_chr(
      list(`Health status`, `Nutrition status`),
      combine_status
    ),
    
    `Are there acute needs ?` = pmap_chr(
      list(
        `Health and nutrition services`,
        `Sanitation and hygiene systems`,
        `Water systems`,
        `Market systems`,
        `Living conditions`,
        `HH water security`,
        `Water Consumption`,
        `HH Food security`,
        `Food consumption`
      ),
      combine_status_an
    ), 
  
    systems_flag_cnt = rowSums(
      cbind(
        `Living conditions system` == "Flag",
        `Water system` == "Flag",
        `Food system` == "Flag",
        `Health and nutrition services system` == "Flag"
      ),
      na.rm = TRUE
    ),
    
    `Does the available evidence indicate RoEM?` = case_when(
      !is.na(`Health outcome`) & `Health outcome` == "Flag" & systems_flag_cnt >= 3 ~ "RoEM",
      !is.na(`Health outcome`) & `Health outcome` %in% c("No Data", "Insufficient Data") & systems_flag_cnt >= 3 ~ "ACUTE NEEDS/CANNOT ANALYSE RoEM",
      TRUE ~ "NO"
    ),
    
    `Are we meeting the RoEM criteria?` = case_when(
      is.na(`Health outcome`) | `Health outcome` %in% c("", "No Data", "Insufficient Data") ~ "NO",  # blank or invalid Health outcome
      rowSums(across(c(
        `Health and nutrition services system`,
        `Living conditions system`,
        `Water system`,
        `Food system`
      ), ~ !is.na(.) & !. %in% c("", "No Data", "Insufficient Data"))) >= 3 &
        !`Health outcome` %in% c("", "No Data", "Insufficient Data") ~ "YES",
      TRUE ~ "NO"
    ),
    
    `Is there Excess Mortality?` = case_when(
      Mortality == "Flag"              ~ "EM",
      Mortality == "No Flag"           ~ "No Excess Mortality",
      Mortality == "Insufficient Data" ~ "Insufficient Data",
      TRUE                             ~ "NO DATA"
    ),
    
    `SUMMARY PRELIMINARY FLAG CONCLUSION` = case_when(
      `Is there Excess Mortality?` == "EM" ~ "Excess Mortality",
      `Does the available evidence indicate RoEM?` == "RoEM" ~ "Risk of Excess Mortality",
      `Are there acute needs ?` == "ACUTE NEEDS" ~ "Acute Needs",
      TRUE ~ "Insufficient Data/Probe with Shocks and Vulnerability"
    ),
    
    `SUMMARY PRELIMINARY FLAG CONCLUSION` = factor(
      `SUMMARY PRELIMINARY FLAG CONCLUSION`,
      levels = custom_order
  )) %>%
  select(`Unit of Analysis Label`, flagging_names) %>%
  arrange(`SUMMARY PRELIMINARY FLAG CONCLUSION`)


summary_results<- final_result%>%
  group_by(`SUMMARY PRELIMINARY FLAG CONCLUSION`) %>%
  summarize(`Number of Localities`= n())


################################################################################
########################## STEP 2 - OUTPUT PREPARING  ##########################
################################################################################

wb <- createWorkbook()

addWorksheet(wb, "STEP 5 Flagging Chart")

writeData(wb, sheet = 1, final_result)

# Define the cell styles for the different conditions with pastel colors (simulating transparency)
flag_style <- createStyle(fontColour = "#FF0000", bgFill = "#FFB3B3", textDecoration = "bold") # Bold red text and light red background for "Flag"

flag_style_darker <- createStyle(
  fontColour = "#FF0000",   # Keep red text
  bgFill = "#990000",       # Dark red background
  textDecoration = "bold"
)

# Darker orange style
orange_style_darker <- createStyle(
  fontColour = "#FF6600",   # Bright orange text
  bgFill = "#FF9933",       # Darker orange background
  textDecoration = "bold"
)
no_flag_style <- createStyle(fontColour = "#006400", bgFill = "#B3D9B3", textDecoration = "bold") # Bold dark green text and light green background for "No Flag"
no_data_style <- createStyle(fontColour = "#808080", bgFill = "#E6E6E6", textDecoration = "bold") # Bold grey text and light grey background for "No Data"


conditionalFormatting(wb, sheet = 1, cols = 1:ncol(final_result), rows = 1:nrow(final_result)+1,
                      rule = '="Flag"', style = flag_style, type = "expression")
conditionalFormatting(wb, sheet = 1, cols = 1:ncol(final_result), rows = 1:nrow(final_result)+1,
                      rule = '="No Flag"', style = no_flag_style, type = "expression")
conditionalFormatting(wb, sheet = 1, cols = 1:ncol(final_result), rows = 1:nrow(final_result)+1,
                      rule = '="No Data"', style = no_data_style, type = "expression")
conditionalFormatting(wb, sheet = 1, cols = 1:ncol(final_result), rows = 1:nrow(final_result)+1,
                      rule = '="Insufficient Data"', style = no_data_style, type = "expression")



header_style <- createStyle(
  textDecoration = "bold", 
  halign = "center",       
  valign = "center",        
  wrapText = TRUE,
  fgFill = "#e34444",       # Red background
  fontColour = "#FFFFFF"    # White font for contrast
)

# Apply the header style to the first row (column names)
addStyle(wb, sheet = 1, style = header_style, rows = 1, cols = 1:ncol(final_result), gridExpand = TRUE)

# Adjust first row to make it wider and taller
setRowHeights(wb, sheet = 1, rows = 1, heights = 50)  
setColWidths(wb, sheet = 1, cols = 1:ncol(final_result), widths = 30) 


################################################# ADD INPUT LONG FORMAT

addWorksheet(wb, "Input Wide")

writeData(wb, sheet = 2, input_wide)

conditionalFormatting(wb, sheet = 2, cols = 1:ncol(input_wide), rows = 1:nrow(input_wide)+1,
                      rule = '="Flag"', style = flag_style, type = "expression")
conditionalFormatting(wb, sheet = 2, cols = 1:ncol(input_wide), rows = 1:nrow(input_wide)+1,
                      rule = '="No Flag"', style = no_flag_style, type = "expression")
conditionalFormatting(wb, sheet = 2, cols = 1:ncol(input_wide), rows = 1:nrow(input_wide)+1,
                      rule = '="No Data"', style = no_data_style, type = "expression")
conditionalFormatting(wb, sheet = 2, cols = 1:ncol(input_wide), rows = 1:nrow(input_wide)+1,
                      rule = '="Insufficient Data"', style = no_data_style, type = "expression")

addStyle(wb, sheet = 2, style = header_style, rows = 1, cols = 1:ncol(input_wide), gridExpand = TRUE)

# Adjust first row to make it wider and taller
setRowHeights(wb, sheet = 2, rows = 1, heights = 50) 
setColWidths(wb, sheet = 2, cols = 1:ncol(input_wide), widths = 30)

################################################# ADD INPUT WIDE FORMAT

addWorksheet(wb, "Input Long")

writeData(wb, sheet = 3, input_long)

conditionalFormatting(wb, sheet = 3, cols = 1:ncol(input_long), rows = 1:nrow(input_long)+1,
                      rule = '="Flag"', style = flag_style, type = "expression")
conditionalFormatting(wb, sheet = 3, cols = 1:ncol(input_long), rows = 1:nrow(input_long)+1,
                      rule = '="No Flag"', style = no_flag_style, type = "expression")
conditionalFormatting(wb, sheet = 3, cols = 1:ncol(input_long), rows = 1:nrow(input_long)+1,
                      rule = '="No Data"', style = no_data_style, type = "expression")
conditionalFormatting(wb, sheet = 3, cols = 1:ncol(input_long), rows = 1:nrow(input_long)+1,
                      rule = '="Insufficient Data"', style = no_data_style, type = "expression")

addStyle(wb, sheet = 3, style = header_style, rows = 1, cols = 1:ncol(input_long), gridExpand = TRUE)

# Adjust first row to make it wider and taller
setRowHeights(wb, sheet = 3, rows = 1, heights = 50) 
setColWidths(wb, sheet = 3, cols = 1:ncol(final_result), widths = 30)

################################################# ADD FLAGGING

addWorksheet(wb, "Source Data Flagged")

# Option A: keep ONLY these columns, in exactly this order
df_metrics_modified <- df_metrics %>%
  left_join(pcodes%>% select(ADM2_EN,ADM2_PCODE), by=join_by("adm2_pcode"=="ADM2_PCODE") )  %>%
  rename(
    `Unit of Analysis`              = adm2_pcode,
    `Unit of Analysis Label`        = ADM2_EN,
    Level                           = level,
    System                          = system,
    Factor                          = factor,
    `Sub-factor`                    = sub_factor,
    `Risk concept`                  = risk_concept,
    Preference                      = preference,
    `Indicator ID`                  = indicator_id,
    `Indicator Metric`              = metric,
    `Data Source`                   = `source`,
    `Indicator Value`               = value,
    `Above or below`                = above_or_below,
    `Acute needs threshold (4)`     = acute_needs_threshold,
    `Very acute needs threshold (5)`= very_acute_needs_threshold,
    `Metric Flag Acute Needs`       = metric_flag,
    `Metric Flag Very Acute Needs`  = metric_flag_very_acute
  ) %>%
  select(
    `Unit of Analysis`, `Unit of Analysis Label`, `Data Source`, `Indicator Value`, 
    `Indicator ID`, `Indicator Metric`, 
    `Metric Flag Acute Needs`, `Metric Flag Very Acute Needs`,
    Level, System, Factor, `Sub-factor`, `Risk concept`,
    Preference,    `Above or below`, `Acute needs threshold (4)`, `Very acute needs threshold (5)`
  ) %>%
  mutate(
    `Metric Flag Acute Needs`=case_when(
      `Metric Flag Acute Needs`==1 ~"Flag",
      `Metric Flag Acute Needs`==0 ~"No Flag",
      T ~"No Threshold"),
    `Metric Flag Very Acute Needs`=case_when(
      `Metric Flag Very Acute Needs`==1 ~"Flag",
      `Metric Flag Very Acute Needs`==0 ~"No Flag",
      T ~"No Threshold"),
  ) 


writeData(wb, sheet = 4, df_metrics_modified)

conditionalFormatting(wb, sheet = 4, cols = 1:ncol( df_metrics_modified), rows = 1:nrow( df_metrics_modified)+1,
                      rule = '="Flag"', style = flag_style, type = "expression")
conditionalFormatting(wb, sheet = 4, cols = 1:ncol( df_metrics_modified), rows = 1:nrow( df_metrics_modified)+1,
                      rule = '="No Flag"', style = no_flag_style, type = "expression")
conditionalFormatting(wb, sheet = 4, cols = 1:ncol( df_metrics_modified), rows = 1:nrow( df_metrics_modified)+1,
                      rule = '="No Threshold"', style = no_data_style, type = "expression")

addStyle(wb, sheet = 4, style = header_style, rows = 1, cols = 1:ncol(df_metrics_modified), gridExpand = TRUE)

# Adjust first row to make it wider and taller
setRowHeights(wb, sheet = 4, rows = 1, heights = 50) 
setColWidths(wb, sheet = 4, cols = 1:ncol(df_metrics_modified), widths = 30)


################################################# ADD SUMMARY 


addWorksheet(wb, "Summary Results")

writeData(wb, sheet = 5, summary_results)

conditionalFormatting(wb, sheet = 5, cols = 1:ncol(summary_results), rows = 1:nrow(summary_results)+1,
                      rule = '="Excess Mortality"', style = flag_style_darker, type = "expression")
conditionalFormatting(wb, sheet = 5, cols = 1:ncol(summary_results), rows = 1:nrow(summary_results)+1,
                      rule = '="Risk of Excess Mortality"', style = flag_style, type = "expression")
conditionalFormatting(wb, sheet = 5, cols = 1:ncol(summary_results), rows = 1:nrow(summary_results)+1,
                      rule = '="Acute Needs"', style =orange_style_darker , type = "expression")
conditionalFormatting(wb, sheet = 5, cols = 1:ncol(summary_results), rows = 1:nrow(summary_results)+1,
                      rule = '="Insufficient Data/Probe with Shocks and Vulnerability"', style = no_data_style, type = "expression")

addStyle(wb, sheet = 5, style = header_style, rows = 1, cols = 1:ncol(summary_results), gridExpand = TRUE)

# Adjust first row to make it wider and taller
setRowHeights(wb, sheet = 5, rows = 1, heights = 50) 
setColWidths(wb, sheet = 5, cols = 1:ncol(final_result), widths = 30)



